# Holocron recording style, shared by every tape in docs/demo/tapes.
#
# The terminal palette is built from Holocron's own colours (internal/style):
# archive cyan (ANSI 44) for structure, amber (214) for highlights, muted
# greys, and the type colours for green/red/blue/violet. The window sits on a
# deep-teal backfill so every image reads as part of one set.

Set FontFamily "JetBrains Mono, Cascadia Mono, DejaVu Sans Mono, Consolas, monospace"
Set FontSize 16
Set LineHeight 1.2
Set Width 1440
Set Height 820
Set Padding 26
Set Margin 36
Set MarginFill "#0B3438"
Set BorderRadius 12
Set WindowBar Rings
Set WindowBarSize 40
Set CursorBlink false
Set TypingSpeed 40ms
Set Framerate 30
Set PlaybackSpeed 1.0
Set Theme { "name": "Holocron", "background": "#0A1416", "foreground": "#D0DADB", "cursor": "#00AFAF", "selection": "#1D3A3E", "black": "#0A1416", "red": "#D75F5F", "green": "#87AF87", "yellow": "#FFAF00", "blue": "#87AFD7", "magenta": "#AF87D7", "cyan": "#00AFAF", "white": "#C6D0D2", "brightBlack": "#5F6F72", "brightRed": "#E58A8A", "brightGreen": "#A8CBA8", "brightYellow": "#FFD07A", "brightBlue": "#A9C9E8", "brightMagenta": "#C9A9E6", "brightCyan": "#5FD7D7", "brightWhite": "#EEF3F3" }
